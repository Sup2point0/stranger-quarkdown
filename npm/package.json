{
  "name": "stranger-quarkdown",
  "author": "Sup#2.0",
  "version": "4.0.0-alpha.0",
  "license": "MIT",

  "description": "Markdown preprocessing for SvelteKit projects",
  "keywords": [
    "svelte", "sveltekit", "mdsvex", "markdown", "squarkdown", "squark"
  ],

  "homepage": "https://github.com/Sup2point0/stranger-quarkdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sup2point0/stranger-quarkdown.git"
  },
  "bugs": {
    "url": "https://github.com/Sup2point0/stranger-quarkdown/issues"
  },

  "type": "module",
  "sideEffects": false,
  "files": [
    "./bin/squarkdown.exe",
    "index.d.ts",
    "package.json",
    "LICENCE"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts"
    }
  },
  "bin": {
    "squarkdown": "bin/squarkdown.exe"
  },
  "os": ["win32"],
  "cpu": ["x64"],

  "scripts": {
    "prepublishOnly": "nu publish.nu"
  }
}
