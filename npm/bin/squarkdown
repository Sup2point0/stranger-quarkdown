#!/usr/bin/env node

import * as path from "node:path";
import { spawn } from "node:child_process";
import { chmodSync } from "node:fs";
import { platform } from "node:process";
import { fileURLToPath } from "node:url";


let bin;

switch (platform) {
	case "linux": bin = "squarkdown-linux"; break;
	case "win32": bin = "squarkdown-win.exe"; break;
	default:
		console.error("Squarkdown currently only supports 'win32' and 'linux' (when installed from NPM), sorry =(");
		process.exit(1);
}

let folder = path.dirname(fileURLToPath(import.meta.url));
let executable = `${folder}/${bin}`;

if (platform === "linux") {
	chmodSync(executable, 0o755);
}

let squarkup = spawn(executable, process.argv.slice(2), {
	stdio: "inherit",
});

squarkup.on("error", e => {
	console.error(e);
	process.exit(1);
});

squarkup.on("exit", code => {
	process.exit(code ?? 1);
});
